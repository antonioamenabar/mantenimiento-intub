# API de Datascope (Settings > Integrations > API en app.mydatascope.com)
DATASCOPE_API_KEY=

# form_id de "R-PR03-01 Formulario de Mantenimiento de Equipos"
DATASCOPE_FORM_ID=658357

# Backend de base de datos: "sqlite" (default, para desarrollo local) o "postgres" (Supabase)
DB_BACKEND=sqlite

# Solo si DB_BACKEND=postgres. Se obtiene en Supabase > Settings > Database > Connection string (modo "URI")
DATABASE_URL=
